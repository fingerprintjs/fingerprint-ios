":"Initialize the SDK","abstract":[{"text":"Add the Fingerprint SDK and configure it with your public API key and region.","type":"text"}],"url":"\/tutorials\/fingerprint\/initializesdk"},"ContentView-07.swift":{"identifier":"ContentView-07.swift","content":["import Fingerprint","import SwiftUI","","struct ContentView: View {","","    @State private var username = \"\"","    @State private var password = \"\"","    @State private var logOutput = \"\"","","    static let configuration = Configuration(","        apiKey: \"PUBLIC_API_KEY\",  \/\/ <-- Your API key","        region: .eu  \/\/ <-- Your region","    )","","    let fingerprintClient = FingerprintFactory.getInstance(configuration)","","    func createAccount() async {","        do {","            let response = try await fingerprintClient.getVisitorIdResponse()","","            let eventId = response.eventId","","            print(\"Event ID: \\(eventId)\")","","            \/\/ Send username, password, and eventId to your backend server for processing","        } catch {","            print(\"Fingerprint error: \\(error)\")","            logOutput = \"Error: \\(error.localizedDescription)\"","        }","    }","","    var body: some View {","        VStack(spacing: 20) {","            Text(\"Create Account\")","                .font(.title)","                .foregroundColor(.orange)","","            TextField(\"Username\", text: $username)","                .textFieldStyle(.roundedBorder)","                .autocapitalization(.none)","","            SecureField(\"Password\", text: $password)","                .textFieldStyle(.roundedBorder)","","            Button(\"Create Account\") {","                Task {","                    await createAccount()","                }","            }","            .buttonStyle(.borderedProminent)","            .tint(.orange)","","            if !logOutput.isEmpty {","                Text(\"Log: \\(logOutput)\")","                    .font(.caption)","                