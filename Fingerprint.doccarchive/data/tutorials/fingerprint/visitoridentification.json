ort SwiftUI","","struct ContentView: View {","","    @State private var username = \"\"","    @State private var password = \"\"","    @State private var logOutput = \"\"","","    static let configuration = Configuration(","        apiKey: \"PUBLIC_API_KEY\",  \/\/ <-- Your API key","        region: .eu  \/\/ <-- Your region","    )","","    var body: some View {","        VStack {","            Image(systemName: \"globe\")","                .imageScale(.large)","                .foregroundStyle(.tint)","            Text(\"Hello, world!\")","        }","        .padding()","    }","}","","#Preview {","    ContentView()","}"],"fileType":"swift","syntax":"swift","type":"file","identifier":"ContentView-05.swift","fileName":"ContentView.swift","highlights":[{"line":6},{"line":7},{"line":8},{"line":9}]},"ContentView-07.swift":{"fileName":"ContentView.swift","identifier":"ContentView-07.swift","fileType":"swift","content":["import Fingerprint","import SwiftUI","","struct ContentView: View {","","    @State private var username = \"\"","    @State private var password = \"\"","    @State private var logOutput = \"\"","","    static let configuration = Configuration(","        apiKey: \"PUBLIC_API_KEY\",  \/\/ <-- Your API key","        region: .eu  \/\/ <-- Your region","    )","","    let fingerprintClient = FingerprintFactory.getInstance(configuration)","","    func createAccount() async {","        do {","            let response = try await fingerprintClient.getVisitorIdResponse()","","            let eventId = response.eventId","","            print(\"Event ID: \\(eventId)\")","","            \/\/ Send username, password, and eventId to your backend server for processing","        } catch {","            print(\"Fingerprint error: \\(error)\")","            logOutput = \"Error: \\(error.localizedDescription)\"","        }","    }","","    var body: some View {","        VStack(spacing: 20) {","            Text(\"Create Account\")","                .font(.title)","    